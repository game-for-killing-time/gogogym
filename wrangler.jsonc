{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gogogym",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/play", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gogogym",
    // Replace with the ID of the database created in YOUR Cloudflare account.
    "database_id": "98a0a67a-a1b4-4778-8d2c-c9b3c8260c8d",
    "migrations_dir": "migrations"
  }]
}
