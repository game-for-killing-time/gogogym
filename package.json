{
  "name": "gogogym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "build": "node scripts/build-static.mjs",
    "dev:cloudflare": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  }
}
